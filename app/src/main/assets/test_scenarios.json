  {
    "testId": "pause_music_while_playing",
    "category": "music",
    "description": "Pause music when music is playing",
    "audioFile": "test_audio/pause_music_while_playing.wav",
    "utterance": "pause",
    "preconditions": [
      {"action": "media.play", "input": {"query": "Taylor Swift"}},
      {"wait": 1500}
    ],
    "expected": {
      "workflowMatched": "pause_music",
      "workflowExecuted": true,
      "workflowSuccess": true,
      "actionsExecuted": ["media.pause", "tts.speak"],
      "databaseChanges": {
        "WorkflowExecution": {"count": 1},
        "ActionExecution": {"count": 2}
      },
      "serviceStateChanges": {"music_player_playing": false},
      "shouldNotExecute": ["media.play", "media.next", "media.previous"]
    }
  },
  {
    "testId": "resume_music_while_paused",
