      "actionsExecuted": ["media.resume", "tts.speak"],
      "databaseChanges": {
        "WorkflowExecution": {"count": 1},
        "ActionExecution": {"count": 2}
      },
      "serviceStateChanges": {"music_player_playing": true},
      "shouldNotExecute": ["media.play", "media.pause"]
    }
  },
