{
  "workflows": [
    {
      "name": "start_task",
      "enabled": true,
      "definition": {
        "triggers": ["start task", "working on", "begin task", "start a"],
        "slots": {
          "taskName": {
            "description": "Name or description of the task. Examples: 'coding', 'report', 'review PRs'",
            "required": true
          }
        },
        "requiresInput": true,
        "steps": [
          {
            "action": "task.start",
            "input": {"name": "$taskName"},
            "output": "task"
          },
          {
            "action": "tts.speak",
            "input": {"text": "Started $task.name"}
          }
        ]
      }
    },
    {
      "name": "pause_task",
      "enabled": true,
      "definition": {
        "triggers": ["pause task", "stop task", "taking a break"],
        "steps": [
          {"action": "task.pause", "output": "task"},
          {"action": "tts.speak", "input": {"text": "Paused $task.name"}}
        ]
      }
    },
    {
      "name": "complete_task",
      "enabled": true,
      "definition": {
        "triggers": ["complete task", "done with task", "finished task"],
        "steps": [
          {"action": "task.complete", "output": "task"},
          {"action": "tts.speak", "input": {"text": "Completed $task.name"}}
        ]
      }
    },
    {
      "name": "resume_task",
      "enabled": true,
      "definition": {
        "triggers": ["resume task", "continue task", "unpause task"],
        "steps": [
          {"action": "task.resume", "output": "task"},
          {"action": "tts.speak", "input": {"text": "Resumed $task.name"}}
        ]
      }
    },
    {
      "name": "task_status",
      "enabled": true,
      "definition": {
        "triggers": ["current task", "what am I working on", "task status", "how long"],
        "steps": [
          {"action": "task.getActive", "output": "task"},
          {"action": "tts.speak", "input": {"text": "$task.elapsed on $task.name"}}
        ]
      }
    },
    {
      "name": "switch_task",
      "enabled": true,
      "definition": {
        "triggers": ["switch to", "switch task", "now working on", "back to"],
        "requiresInput": true,
        "steps": [
          {"action": "task.getNonCompleted", "output": "available"},
          {
            "action": "control.if",
            "condition": "$available.tasks.length === 0",
            "then": [
              {"action": "tts.speak", "input": {"text": "No tasks available. Creating new task."}},
              {
                "action": "llm.prompt",
                "input": {
                  "systemPrompt": "Extract the task name/description from the user's command. Return ONLY the task name, nothing else. Examples: 'start a coding task' → 'coding', 'begin working on the report' → 'report', 'start task review PRs' → 'review PRs'",
                  "userPrompt": "$transcript"
                },
                "output": "taskName"
              },
              {"action": "task.start", "input": {"name": "$taskName.response"}, "output": "task"},
              {"action": "tts.speak", "input": {"text": "Started $task.name"}}
            ],
            "else": [
              {
                "action": "llm.prompt",
                "input": {
                  "systemPrompt": "You are a task matcher. Given a user's voice input and a list of tasks, determine which task they're referring to. Return ONLY valid JSON. Output format: {\"taskId\": <id or null>, \"reason\": \"brief explanation\"}",
                  "userPrompt": "$transcript\n\nAvailable tasks:\n$available.tasks",
                  "temperature": 0.3,
                  "maxTokens": 50
                },
                "output": "llmResponse"
              },
              {
                "action": "control.if",
                "condition": "$llmResponse.response.taskId !== null",
                "then": [
                  {"action": "task.resume", "input": {"taskId": "$llmResponse.response.taskId"}, "output": "task"},
                  {"action": "tts.speak", "input": {"text": "Switched to $task.name"}}
                ],
                "else": [
                  {"action": "tts.speak", "input": {"text": "Couldn't match task. Creating new."}},
                  {
                    "action": "llm.prompt",
                    "input": {
                      "systemPrompt": "Extract the task name/description from the user's command. Return ONLY the task name, nothing else. Examples: 'start a coding task' → 'coding', 'begin working on the report' → 'report', 'start task review PRs' → 'review PRs'",
                      "userPrompt": "$transcript"
                    },
                    "output": "taskName"
                  },
                  {"action": "task.start", "input": {"name": "$taskName.response"}, "output": "task"},
                  {"action": "tts.speak", "input": {"text": "Started $task.name"}}
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "log_entry",
      "enabled": true,
      "definition": {
        "triggers": ["log this"],
        "requiresInput": true,
        "steps": [
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Classify what's being logged and extract data.\n\nValid types: medication, food, supplement, activity, symptom, unknown\n\nReturn JSON:\n{\n  \"type\": \"<one of the valid types>\",\n  \"data\": {\n    // For medication: {\"name\": \"string\", \"dosage\": \"string\"}\n    // For food: {\"name\": \"string\", \"quantity\": \"string\", \"meal\": \"string\"}\n    // For supplement: {\"name\": \"string\", \"amount\": \"string\"}\n    // For activity: {\"name\": \"string\", \"duration\": \"string\"}\n    // For symptom: {\"name\": \"string\", \"severity\": \"string\"}\n    // Extract whatever fields make sense for the type\n  }\n}\n\nIf unclear, use type: \"unknown\" and capture what you can.",
              "userPrompt": "$transcript",
              "temperature": 0.3,
              "maxTokens": 150
            },
            "output": "classification"
          },
          {
            "action": "log.write",
            "input": {
              "type": "$classification.response.type",
              "data": "$classification.response.data",
              "transcriptId": "$transcriptId"
            },
            "output": "entry"
          },
          {"action": "tts.speak", "input": {"text": "Logged $classification.response.type"}}
        ]
      }
    },
    {
      "name": "thinker",
      "enabled": false,
      "definition": {
        "triggers": {
          "keywords": ["update narrative", "what do you know", "tell me what you understand"],
          "onWorkflowComplete": ["start_task", "pause_task", "complete_task", "switch_task", "log_entry"]
        },
        "steps": [
          {"action": "state.gather", "output": "state"},
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "You are the internal reasoning system for an ambient AI assistant. Synthesize current state into a 2-3 sentence first-person narrative focusing on: what user is doing (GOALS), why and how it's going (REASONING), key patterns to remember (MEMORY). Be concise and focus on actionable understanding.",
              "userPrompt": "Current state:\n$state",
              "temperature": 0.7,
              "maxTokens": 200
            },
            "output": "narrative"
          },
          {
            "action": "narrative.save",
            "input": {
              "text": "$narrative.response",
              "stateSnapshot": "$state"
            }
          }
        ]
      }
    },
    {
      "name": "review_workflow",
      "enabled": false,
      "definition": {
        "triggers": [],
        "steps": [
          {
            "action": "workflow.getExecutionData",
            "input": {
              "workflowId": "$context.targetWorkflowId",
              "limit": 100
            },
            "output": "executionData"
          },
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "You are analyzing workflow execution data to suggest improvements. Return ONLY valid JSON, no markdown fences.",
              "userPrompt": "Analyze workflow execution data and suggest improvements.\n\nWORKFLOW: $executionData.workflow.name\nStatus: $executionData.workflow.enabled\n\nREVIEW NOTES:\n$executionData.workflow.reviewNotes\n\nEXECUTION SUMMARY:\n- Total: $executionData.summary.totalExecutions\n- Successful: $executionData.summary.successfulExecutions\n- Failed: $executionData.summary.failedExecutions\n- LLM actions: $executionData.summary.llmActions\n- Graded: $executionData.summary.gradedLlmActions\n- Avg grade: $executionData.summary.avgLlmGrade\n\nRECENT EXECUTIONS:\n$executionData.recentExecutions\n\nFAILED EXECUTIONS:\n$executionData.failedExecutions\n\nFAILED ACTIONS:\n$executionData.failedActions\n\nGRADED ACTIONS:\n$executionData.gradedActions\n\nReturn JSON:\n{\n  \"workflow_refinements\": [{\"type\": \"trigger_add|trigger_remove|prompt_update|tts_update\", \"path\": \"path\", \"value\": \"new\", \"old_value\": \"old\", \"rationale\": \"why\"}],\n  \"workflow_expansions\": [{\"name\": \"name\", \"triggers\": [\"phrases\"], \"rationale\": \"why\"}],\n  \"llm_grading_insights\": [{\"action_id\": 123, \"suggested_grade\": 4, \"notes\": \"why\"}]\n}"
            },
            "output": "suggestions"
          }
        ]
      }
    },
    {
      "name": "get_time",
      "enabled": true,
      "definition": {
        "triggers": ["give me the time", "what's the time", "what time", "get time"],
        "steps": [
          {"action": "time.get", "input": {}, "output": "time"},
          {"action": "tts.speak", "input": {"text": "$time.response"}}
        ]
      }
    },
    {
      "name": "set_timer",
      "enabled": true,
      "definition": {
        "triggers": ["set a timer", "set timer", "set alarm", "set an alarm", "timer for", "start a timer"],
        "requiresInput": true,
        "steps": [
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Extract the timer duration from the user's input. Return ONLY valid JSON with no markdown fences. Format: {\"minutes\": <number>, \"seconds\": <number>}. If they say '5 minutes', return {\"minutes\": 5, \"seconds\": 0}. If they say '30 seconds', return {\"minutes\": 0, \"seconds\": 30}.",
              "userPrompt": "$transcript",
              "temperature": 0.1,
              "maxTokens": 100
            },
            "output": "duration"
          },
          {
            "action": "timer.set",
            "input": {
              "minutes": "$duration.response.minutes",
              "seconds": "$duration.response.seconds"
            },
            "output": "timer"
          },
          {"action": "tts.speak", "input": {"text": "Timer set for $timer.message"}}
        ]
      }
    },
    {
      "name": "cancel_timer",
      "enabled": true,
      "definition": {
        "triggers": ["cancel timer", "stop timer", "cancel alarm", "clear timer"],
        "steps": [
          {"action": "timer.cancel", "output": "result"},
          {"action": "tts.speak", "input": {"text": "$result.message"}}
        ]
      }
    },
    {
      "name": "play_music",
      "enabled": true,
      "definition": {
        "triggers": {
          "keywords": ["play some music", "play music", "play song", "listen to", "play artist", "play album", "shuffle", "put on some", "play a youtube video", "play youtube video", "play video about", "play a video about", "play youtube"]
        },
        "slots": {
          "query": {
            "description": "Specific song, artist, or album to play. Return null if user wants random/shuffle music without specifying what. Examples: 'play Taylor Swift' → 'Taylor Swift', 'play some music' → null, 'shuffle' → null",
            "required": false,
            "default": "random"
          }
        },
        "requiresInput": true,
        "steps": [
          {"action": "media.play", "input": {"query": "$query"}, "output": "musicResult"},
          {
            "action": "control.if",
            "condition": "$musicResult.success === false",
            "then": [
              {"action": "media.searchAndSelect", "input": {"query": "$query", "max_results": 5}, "output": "selected"},
              {
                "action": "control.if",
                "condition": "$selected.success === true",
                "then": [
                  {"action": "media.download", "input": {"video_id": "$selected.video_id"}, "output": "downloaded"},
                  {
                    "action": "control.if",
                    "condition": "$downloaded.success === true",
                    "then": [
                      {"action": "media.play", "input": {"query": "$downloaded.title"}, "output": "playResult"},
                      {"action": "tts.speak", "input": {"text": "Playing $downloaded.title"}}
                    ],
                    "else": [
                      {"action": "tts.speak", "input": {"text": "Download failed"}}
                    ]
                  }
                ],
                "else": [
                  {"action": "tts.speak", "input": {"text": "Not found"}}
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "pause_music",
      "enabled": true,
      "definition": {
        "triggers": {
          "keywords": ["pause", "pause music", "stop music"],
          "conditions": {"playbackActive": true}
        },
        "steps": [
          {"action": "media.pause", "output": "result"},
          {"action": "tts.speak", "input": {"text": "Music paused"}}
        ]
      }
    },
    {
      "name": "next_track",
      "enabled": true,
      "definition": {
        "triggers": {
          "keywords": ["next", "next song", "skip", "skip song"],
          "conditions": {"playbackActive": true}
        },
        "steps": [
          {"action": "media.next"}
        ]
      }
    },
    {
      "name": "previous_track",
      "enabled": true,
      "definition": {
        "triggers": {
          "keywords": ["previous", "previous song", "go back", "last song"],
          "conditions": {"playbackActive": true}
        },
        "steps": [
          {"action": "media.previous"}
        ]
      }
    },
    {
      "name": "now_playing",
      "enabled": true,
      "definition": {
        "triggers": {
          "keywords": ["what's playing", "what song is this", "what's this song", "current song"],
          "conditions": {}
        },
        "steps": [
          {"action": "media.getNowPlaying", "output": "result"},
          {"action": "tts.speak", "input": {"text": "$result.response"}}
        ]
      }
    },
    {
      "name": "stop_music",
      "enabled": true,
      "definition": {
        "triggers": {
          "keywords": ["stop", "stop music", "stop playing", "stop that"],
          "conditions": {"playbackActive": true}
        },
        "steps": [
          {"action": "media.stop", "output": "result"},
          {"action": "tts.speak", "input": {"text": "Music stopped"}}
        ]
      }
    },
    {
      "name": "list_all_songs",
      "enabled": true,
      "definition": {
        "triggers": {
          "keywords": ["list all songs", "show all music", "list music library", "debug music"],
          "conditions": {}
        },
        "requiresInput": false,
        "steps": [
          {"action": "media.scan", "output": "result"},
          {"action": "ui.showModal", "input": {"title": "Music Library ($result.totalSongs songs)", "message": "$result.songList"}},
          {"action": "tts.speak", "input": {"text": "$result.summary"}}
        ]
      }
    },
    {
      "name": "llm_response",
      "enabled": true,
      "definition": {
        "triggers": ["what do you think", "your thoughts", "any ideas", "help me think"],
        "requiresInput": true,
        "steps": [
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "You are a helpful AI assistant. Provide a thoughtful, conversational response to the user's question or request.",
              "userPrompt": "$transcript",
              "temperature": 0.7,
              "maxTokens": 300
            },
            "output": "response"
          },
          {"action": "tts.speak", "input": {"text": "$response.response"}}
        ]
      }
    },
    {
      "name": "web_research",
      "enabled": true,
      "definition": {
        "triggers": ["what's happening with", "what is happening with", "tell me about", "research"],
        "requiresInput": true,
        "steps": [
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Extract the research topic from the user's query. Return only the search terms, nothing else.",
              "userPrompt": "$transcript",
              "temperature": 0.1,
              "maxTokens": 50
            },
            "output": "topic"
          },
          {
            "action": "search.query",
            "input": {
              "query": "$topic.response news",
              "numResults": 3
            },
            "output": "searchResults"
          },
          {
            "action": "browser.navigate",
            "input": {"url": "$searchResults.results.0.url"},
            "output": "session"
          },
          {
            "action": "browser.extract",
            "input": {"sessionId": "$session.sessionId"},
            "output": "content"
          },
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "You are a research assistant. Analyze the web content and provide a concise, insightful summary of what's happening. Focus on key facts, recent developments, and actionable insights. Keep it under 100 words.",
              "userPrompt": "Topic: $topic.response\n\nWeb content:\n$content.bodyText",
              "temperature": 0.5,
              "maxTokens": 200
            },
            "output": "analysis"
          },
          {
            "action": "tts.speak",
            "input": {"text": "$analysis.response"}
          },
          {
            "action": "browser.close",
            "input": {"sessionId": "$session.sessionId"}
          }
        ]
      }
    },
    {
      "name": "get_weather",
      "enabled": true,
      "definition": {
        "triggers": ["get me the weather", "weather forecast", "what's the weather", "how's the weather"],
        "requiresInput": false,
        "steps": [
          {
            "action": "search.query",
            "input": {
              "query": "weather forecast today",
              "numResults": 1
            },
            "output": "searchResults"
          },
          {
            "action": "browser.navigate",
            "input": {"url": "$searchResults.results.0.url"},
            "output": "session"
          },
          {
            "action": "browser.extract",
            "input": {"sessionId": "$session.sessionId"},
            "output": "content"
          },
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Extract and summarize the weather forecast from this page. Include temperature, conditions, and any notable weather events. Be conversational and brief.",
              "userPrompt": "$content.bodyText",
              "temperature": 0.3,
              "maxTokens": 150
            },
            "output": "forecast"
          },
          {
            "action": "tts.speak",
            "input": {"text": "$forecast.response"}
          },
          {
            "action": "browser.close",
            "input": {"sessionId": "$session.sessionId"}
          }
        ]
      }
    },
    {
      "name": "find_code",
      "enabled": true,
      "definition": {
        "triggers": ["find me some", "show me examples", "find examples", "code examples"],
        "requiresInput": true,
        "steps": [
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Extract the programming topic from the user's request. Return only the technical search terms.",
              "userPrompt": "$transcript",
              "temperature": 0.1,
              "maxTokens": 50
            },
            "output": "topic"
          },
          {
            "action": "search.query",
            "input": {
              "query": "$topic.response examples code",
              "numResults": 3
            },
            "output": "searchResults"
          },
          {
            "action": "browser.navigate",
            "input": {"url": "$searchResults.results.0.url"},
            "output": "session"
          },
          {
            "action": "browser.extract",
            "input": {"sessionId": "$session.sessionId"},
            "output": "content"
          },
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "You found code examples. Extract the most useful code snippet and explain it clearly in 2-3 sentences. Focus on what it does and when to use it.",
              "userPrompt": "Topic: $topic.response\n\nPage content:\n$content.bodyText",
              "temperature": 0.4,
              "maxTokens": 250
            },
            "output": "explanation"
          },
          {
            "action": "tts.speak",
            "input": {"text": "$explanation.response"}
          },
          {
            "action": "browser.close",
            "input": {"sessionId": "$session.sessionId"}
          }
        ]
      }
    },
    {
      "name": "summarize_news",
      "enabled": true,
      "definition": {
        "triggers": ["summarize", "news summary", "what's in the news", "today's news"],
        "requiresInput": true,
        "steps": [
          {
            "action": "search.query",
            "input": {
              "query": "latest $transcript",
              "numResults": 3
            },
            "output": "searchResults"
          },
          {
            "action": "browser.navigate",
            "input": {"url": "$searchResults.results.0.url"},
            "output": "session"
          },
          {
            "action": "browser.extract",
            "input": {"sessionId": "$session.sessionId"},
            "output": "content"
          },
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Summarize the key news from this content. Provide 3-4 bullet points of the most important stories. Be concise and informative.",
              "userPrompt": "$content.bodyText",
              "temperature": 0.4,
              "maxTokens": 200
            },
            "output": "summary"
          },
          {
            "action": "tts.speak",
            "input": {"text": "$summary.response"}
          },
          {
            "action": "browser.close",
            "input": {"sessionId": "$session.sessionId"}
          }
        ]
      }
    },
    {
      "name": "web_answer",
      "enabled": true,
      "definition": {
        "triggers": ["when is", "when does", "what time", "where is", "how do I"],
        "requiresInput": true,
        "steps": [
          {
            "action": "search.query",
            "input": {
              "query": "$transcript",
              "numResults": 3
            },
            "output": "searchResults"
          },
          {
            "action": "browser.navigate",
            "input": {"url": "$searchResults.results.0.url"},
            "output": "session"
          },
          {
            "action": "browser.extract",
            "input": {"sessionId": "$session.sessionId"},
            "output": "content"
          },
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Answer the user's specific question based on this web content. Be direct and provide the exact information they asked for. If the information isn't available, say so clearly.",
              "userPrompt": "Question: $transcript\n\nWeb content:\n$content.bodyText",
              "temperature": 0.3,
              "maxTokens": 150
            },
            "output": "answer"
          },
          {
            "action": "tts.speak",
            "input": {"text": "$answer.response"}
          },
          {
            "action": "browser.close",
            "input": {"sessionId": "$session.sessionId"}
          }
        ]
      }
    },
    {
      "name": "play_latest_podcast",
      "enabled": true,
      "definition": {
        "triggers": ["play latest podcast", "latest podcast", "play latest from", "play newest episode", "latest episode", "newest from", "play latest episode", "latest episode of", "newest episode of"],
        "requiresInput": true,
        "steps": [
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Extract the podcast/show name from the user's request. Return only the name, nothing else.",
              "userPrompt": "$transcript",
              "temperature": 0.1,
              "maxTokens": 50
            },
            "output": "showName"
          },
          {
            "action": "subscription.list",
            "input": {"platform": "podcast"},
            "output": "subscriptions"
          },
          {
            "action": "control.if",
            "condition": "$subscriptions.count > 0",
            "then": [
              {
                "action": "llm.prompt",
                "input": {
                  "systemPrompt": "Match the show name to one of the subscriptions. Return ONLY valid JSON: {\"subscription_id\": <id>, \"title\": \"matched title\"}. If no match found, return {\"subscription_id\": 0, \"title\": \"\"}",
                  "userPrompt": "Find: $showName.response\n\nSubscriptions:\n$subscriptions.subscriptions",
                  "temperature": 0.1,
                  "maxTokens": 50
                },
                "output": "matched"
              },
              {
                "action": "control.if",
                "condition": "$matched.response.subscription_id > 0",
                "then": [
                  {
                    "action": "subscription.listContent",
                    "input": {
                      "platform": "podcast",
                      "subscription_id": "$matched.response.subscription_id",
                      "limit": 1
                    },
                    "output": "episodes"
                  },
                  {
                    "action": "control.if",
                    "condition": "$episodes.count > 0",
                    "then": [
                      {
                        "action": "subscription.getContent",
                        "input": {
                          "platform": "podcast",
                          "id": "$episodes.items[0].id"
                        },
                        "output": "episode"
                      },
                      {
                        "action": "media.play.podcast",
                        "input": {
                          "query": "$episode.title"
                        },
                        "output": "playResult"
                      },
                      {
                        "action": "tts.speak",
                        "input": {"text": "Playing $episode.title from $matched.response.title"}
                      }
                    ],
                    "else": [
                      {"action": "tts.speak", "input": {"text": "No episodes found for $matched.response.title"}}
                    ]
                  }
                ],
                "else": [
                  {"action": "tts.speak", "input": {"text": "Couldn't find podcast matching $showName.response"}}
                ]
              }
            ],
            "else": [
              {"action": "tts.speak", "input": {"text": "You don't have any podcast subscriptions"}}
            ]
          }
        ]
      }
    },
    {
      "name": "play_latest_youtube",
      "enabled": true,
      "definition": {
        "triggers": ["play latest youtube", "latest youtube video", "play latest youtube video", "play latest video from", "play newest video", "latest video from", "newest video from"],
        "requiresInput": true,
        "steps": [
          {
            "action": "llm.prompt",
            "input": {
              "systemPrompt": "Extract the YouTube channel name from the user's request. Return only the name, nothing else.",
              "userPrompt": "$transcript",
              "temperature": 0.1,
              "maxTokens": 50
            },
            "output": "channelName"
          },
          {
            "action": "subscription.list",
            "input": {"platform": "youtube"},
            "output": "subscriptions"
          },
          {
            "action": "control.if",
            "condition": "$subscriptions.count > 0",
            "then": [
              {
                "action": "llm.prompt",
                "input": {
                  "systemPrompt": "Match the channel name to one of the subscriptions. Return ONLY valid JSON: {\"subscription_id\": <id>, \"channel_name\": \"matched name\"}. If no match found, return {\"subscription_id\": 0, \"channel_name\": \"\"}",
                  "userPrompt": "Find: $channelName.response\n\nSubscriptions:\n$subscriptions.subscriptions",
                  "temperature": 0.1,
                  "maxTokens": 50
                },
                "output": "matched"
              },
              {
                "action": "control.if",
                "condition": "$matched.response.subscription_id > 0",
                "then": [
                  {
                    "action": "subscription.listContent",
                    "input": {
                      "platform": "youtube",
                      "subscription_id": "$matched.response.subscription_id",
                      "limit": 1
                    },
                    "output": "videos"
                  },
                  {
                    "action": "control.if",
                    "condition": "$videos.count > 0",
                    "then": [
                      {
                        "action": "subscription.getContent",
                        "input": {
                          "platform": "youtube",
                          "id": "$videos.items[0].id"
                        },
                        "output": "video"
                      },
                      {
                        "action": "media.play.youtube",
                        "input": {
                          "query": "$video.title"
                        },
                        "output": "playResult"
                      },
                      {
                        "action": "tts.speak",
                        "input": {"text": "Playing $video.title from $matched.response.channel_name"}
                      }
                    ],
                    "else": [
                      {"action": "tts.speak", "input": {"text": "No videos found for $matched.response.channel_name"}}
                    ]
                  }
                ],
                "else": [
                  {"action": "tts.speak", "input": {"text": "Couldn't find channel matching $channelName.response"}}
                ]
              }
            ],
            "else": [
              {"action": "tts.speak", "input": {"text": "You don't have any YouTube subscriptions"}}
            ]
          }
        ]
      }
    }
  ]
}
